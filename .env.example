# ==============================================================================
# VESTIGE STUDIO — Environment Configuration
# ==============================================================================

# Gemini AI Director API Key (Google AI Studio)
# Required for live generative Director Plans.
# If omitted, VESTIGE STUDIO automatically falls back to curated director models.
GEMINI_API_KEY=

# Pexels API Key
# Required for searching and retrieving live stock footage.
# If omitted, VESTIGE STUDIO falls back to bundled high-resolution sample clips.
PEXELS_API_KEY=

# Freesound API Key
# Required for searching and retrieving natural acoustic soundscapes and hydrophone audio.
# If omitted, VESTIGE STUDIO falls back to bundled sample environmental sounds.
FREESOUND_API_KEY=

# Optional Custom FFmpeg Binary Path
# When running on Vercel, the bundled ffmpeg-static binary is automatically resolved.
# On custom servers or Docker containers, set this to override the path:
# FFMPEG_PATH=/usr/bin/ffmpeg

# Public Application URL (used for internal sample asset routing during render)
NEXT_PUBLIC_APP_URL=http://localhost:3000
